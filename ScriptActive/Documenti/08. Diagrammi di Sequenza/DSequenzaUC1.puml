' ============================================================
' UC1 - Registrazione e Creazione Profilo
' Ogni blocco genera l'immagine omonima in "Visualizzazioni".
' ============================================================

@startuml DSequenzaUC1Main
skinparam maxMessageSize 200
skinparam monochrome false

title UC1 - Registrazione (Flusso Principale)

actor "Cliente" as C
boundary "view : RegistrazioneView" as View
control "gestore : GestoreRegistrazione" as Controller
database "sedeDAO : SedeDAO" as SDAO
database "clienteDAO : ClienteDAO" as CDAO
participant "Tariffario\n<<Domain>>" as Tar
control "servizioPagamenti :\nServizioPagamenti" as GP
entity "nuovoCliente : Cliente" as Cliente
entity "nuovoAbbonamento : Abbonamento" as Abbonamento
participant "Navigatore\n<<Interface>>" as Nav

' Le sedi arrivano dal Controller: la View non accede alla persistenza
View -> Controller : getSediDisponibili()
activate Controller
Controller -> SDAO : getTutteLeSedi()
activate SDAO
SDAO --> Controller : List<Sede>
deactivate SDAO
Controller --> View : List<Sede>
deactivate Controller

C -> View : compilaModulo(nome, cognome, email, password, CF, sedeScelta, tipo, livello, rinnovoAutomatico, iban)
activate View

View -> Controller : registraNuovoCliente(nome, cognome, email, password, CF, sedeScelta, tipo, livello, rinnovoAutomatico, iban)
activate Controller

' Validazione dei dati
Controller -> Controller : valida campi obbligatori, password e formato IBAN

' Controllo duplicati
Controller -> CDAO : getClienteByCF(codiceFiscale)
activate CDAO
CDAO --> Controller : null
deactivate CDAO

' Creazione entità Cliente
create Cliente
Controller -> Cliente : <<create>> Cliente(nome, cognome, email, codiceFiscale, sedeScelta, tipo)
Controller -> Cliente : setPassword(password)

' Calcolo dell'importo (regola di dominio)
Controller -> Tar : calcolaImporto(tipo, livello)
activate Tar
Tar --> Controller : importo
deactivate Tar

' Pagamento tramite il servizio ricevuto dal costruttore (Dependency Injection)
Controller -> GP : elaboraPagamento(iban, importo)
activate GP
GP --> Controller : true
deactivate GP

' Creazione e associazione Abbonamento
create Abbonamento
Controller -> Abbonamento : <<create>> Abbonamento(codiceFiscale, livello, tipo, rinnovoAutomatico, iban)
Controller -> Abbonamento : setDataScadenza(oggi + livello.getMesi())
Controller -> Cliente : setAbbonamentoAttivo(nuovoAbbonamento)

' Salvataggio nel DB
Controller -> CDAO : inserisciCliente(nuovoCliente)
activate CDAO
CDAO --> Controller : true
deactivate CDAO

' Ritorno alla View
Controller --> View : (nessuna eccezione)
deactivate Controller
View --> C : mostraMessaggio("Iscrizione completata!")

' Alla chiusura la View esegue l'azione registrata dal Composition Root
View -> Nav : apriLogin()
deactivate View
@enduml


@startuml DSequenzaUC1Alt
skinparam maxMessageSize 200
skinparam monochrome false

title UC1 - Registrazione (Flusso Alternativo: Errore Pagamento)

actor "Cliente" as C
boundary "view : RegistrazioneView" as View
control "gestore : GestoreRegistrazione" as Controller
database "clienteDAO : ClienteDAO" as CDAO
participant "Tariffario\n<<Domain>>" as Tar
control "servizioPagamenti :\nServizioPagamenti" as GP
entity "nuovoCliente : Cliente" as Cliente

C -> View : compilaModulo(nome, cognome, email, password, CF, sedeScelta, tipo, livello, rinnovoAutomatico, iban)
activate View

View -> Controller : registraNuovoCliente(nome, cognome, email, password, CF, sedeScelta, tipo, livello, rinnovoAutomatico, iban)
activate Controller

Controller -> Controller : valida campi obbligatori, password e formato IBAN

' Controllo duplicati
Controller -> CDAO : getClienteByCF(codiceFiscale)
activate CDAO
CDAO --> Controller : null
deactivate CDAO

' Creazione entità Cliente (solo in memoria)
create Cliente
Controller -> Cliente : <<create>> Cliente(nome, cognome, email, codiceFiscale, sedeScelta, tipo)
Controller -> Cliente : setPassword(password)

Controller -> Tar : calcolaImporto(tipo, livello)
activate Tar
Tar --> Controller : importo
deactivate Tar

' Tentativo di pagamento
Controller -> GP : elaboraPagamento(iban, importo)
activate GP
GP --> Controller : throws PagamentoFallitoException
deactivate GP

' Interruzione immediata del flusso: il cliente non viene salvato
Controller --> View : throws PagamentoFallitoException
deactivate Controller

View --> C : mostraMessaggio("Transazione Rifiutata")
deactivate View
@enduml
