' ============================================================
' UC5 - Gestione dei Contratti del Personale
' Diagrammi di sequenza PlantUML
' Ordine: flussi di successo, poi flussi alternativi
' Ogni blocco genera l'immagine omonima in "Visualizzazioni".
' ============================================================

' ------------------------------------------------------------
' 01 - SS1 - Assunzione Personal Trainer
' ------------------------------------------------------------
@startuml DSequenzaUC5Main1
title UC5 - Main Success Scenario: Assunzione Personal Trainer

autonumber

actor "Direttore" as Direttore
boundary "GestionePersonaleView\n<<Boundary>>" as View
control "GestorePersonale\n<<Controller>>" as Controller
control "servizio: ServizioContrattiPersonale\n<<Service>>" as Servizio
entity "trainerDAO: PersonalTrainerDAO\n<<Interface>>" as PTDAO
entity "direttoreDAO: DirettoreDAO\n<<Interface>>" as DirDAO
participant "StrategiaRetribuzioneFactory\n<<Factory>>" as Factory
entity "nuovoPT: PersonalTrainer\n<<Entity>>" as NuovoPT
database "scriptactive_db" as DB

Direttore -> View : inserisce dati PT
Direttore -> View : clicca "Assumi PT"

note right of View
La View non espone i propri bottoni: esegue l'azione
che il Controller ha registrato con onAssumi(...)
end note
View -> Controller : gestisciAssunzione()
activate Controller

Controller -> View : getNomeInserito(), getCognomeInserito(), getEmailInserita(), ...
View --> Controller : dati inseriti

Controller -> Servizio : assumiPersonalTrainer(nome, cognome, email, specializzazione, tipoRetribuzione, importo)
activate Servizio

Servizio -> Servizio : normalizza e valida i dati

Servizio -> PTDAO : trovaPerEmail(email)
activate PTDAO
PTDAO -> DB : SELECT PT WHERE email = ?
activate DB
DB --> PTDAO : nessun risultato
deactivate DB
PTDAO --> Servizio : null
deactivate PTDAO

Servizio -> Factory : crea(tipoRetribuzione, importo)
activate Factory
note right of Factory
Pattern Strategy
end note
Factory --> Servizio : strategia
deactivate Factory

create NuovoPT
Servizio -> NuovoPT : <<create>> PersonalTrainer(nome, cognome, email, null, specializzazione, strategia)

Servizio -> DirDAO : trovaIdDirettoreDisponibile()
activate DirDAO
DirDAO --> Servizio : idDirettore
deactivate DirDAO

Servizio -> PTDAO : salva(datiNuovoTrainer)
activate PTDAO
PTDAO -> DB : INSERT Utente + PersonalTrainer
activate DB
DB --> PTDAO : ok
deactivate DB
PTDAO --> Servizio
deactivate PTDAO

Servizio --> Controller : assunzione completata
deactivate Servizio

Controller -> View : pulisciFormAssunzione()
Controller -> Servizio : getElencoPersonalTrainer()
activate Servizio
Servizio --> Controller : List<DatiVisualizzazioneTrainer>
deactivate Servizio
Controller -> View : mostraRigheTrainer(righe)
Controller -> View : mostraSuccesso("Personal Trainer assunto correttamente.")
deactivate Controller

View --> Direttore : mostra conferma assunzione

@enduml

' ------------------------------------------------------------
' 02 - SS2 - Licenziamento senza sostituto
' ------------------------------------------------------------
@startuml DSequenzaUC5Main2
title UC5 - Main Success Scenario: Licenziamento senza sostituto

autonumber

actor "Direttore" as Direttore
boundary "GestionePersonaleView\n<<Boundary>>" as View
control "GestorePersonale\n<<Controller>>" as Controller
control "servizio: ServizioContrattiPersonale\n<<Service>>" as Servizio
entity "trainerDAO: PersonalTrainerDAO\n<<Interface>>" as PTDAO
control "servizioSwapCorsi: ServizioSwapCorsi\n<<Service>>" as SwapService
entity "swapCorsiDAO: SwapCorsiDAO\n<<Interface>>" as SwapDAO
database "scriptactive_db" as DB

Direttore -> View : seleziona PT da licenziare
Direttore -> View : clicca "Licenzia senza sostituto"

View -> Controller : gestisciLicenziamentoSenzaSostituto()
activate Controller

Controller -> View : getIdTrainerDaLicenziare()
View --> Controller : idTrainer

Controller -> Servizio : licenziaPersonalTrainerSenzaSostituto(idTrainer)
activate Servizio

Servizio -> PTDAO : trovaPerId(idTrainer)
activate PTDAO
PTDAO -> DB : SELECT PT da licenziare
activate DB
DB --> PTDAO : dati PT da licenziare
deactivate DB
PTDAO --> Servizio : datiTrainer
deactivate PTDAO

Servizio -> Servizio : validaTrainerLicenziabile(trainer)

Servizio -> SwapService : haCorsiAttiviOFuturi(idTrainer)
activate SwapService
SwapService -> SwapDAO : esistonoCorsiAttiviOFuturiPerTrainer(idTrainer)
activate SwapDAO
SwapDAO -> DB : SELECT corsi attivi/futuri del PT
activate DB
DB --> SwapDAO : nessun corso
deactivate DB
SwapDAO --> SwapService : false
deactivate SwapDAO
SwapService --> Servizio : false
deactivate SwapService

Servizio -> PTDAO : disattiva(idTrainer)
activate PTDAO
PTDAO -> DB : UPDATE PT (contratto cessato, non attivo)
activate DB
DB --> PTDAO : ok
deactivate DB
PTDAO --> Servizio
deactivate PTDAO

Servizio --> Controller : licenziamento completato
deactivate Servizio

Controller -> View : pulisciFormLicenziamento()
Controller -> Servizio : getElencoPersonalTrainer()
activate Servizio
Servizio --> Controller : List<DatiVisualizzazioneTrainer>
deactivate Servizio
Controller -> View : mostraRigheTrainer(righe)
Controller -> View : mostraSuccesso("Personal Trainer licenziato correttamente senza sostituto.")
deactivate Controller

View --> Direttore : mostra conferma licenziamento

@enduml

' ------------------------------------------------------------
' 03 - SS3 - Licenziamento con sostituto
' ------------------------------------------------------------
@startuml DSequenzaUC5Main3
title UC5 - Main Success Scenario: Licenziamento con sostituto

autonumber

actor "Direttore" as Direttore
boundary "GestionePersonaleView\n<<Boundary>>" as View
control "GestorePersonale\n<<Controller>>" as Controller
control "servizio: ServizioContrattiPersonale\n<<Service>>" as Servizio
entity "trainerDAO: PersonalTrainerDAO\n<<Interface>>" as PTDAO
control "servizioSwapCorsi: ServizioSwapCorsi\n<<Service>>" as SwapService
entity "swapCorsiDAO: SwapCorsiDAO\n<<Interface>>" as SwapDAO
database "scriptactive_db" as DB

Direttore -> View : seleziona PT da licenziare
note right of View
Alla selezione il Controller chiede al Service
i sostituti compatibili e li mostra nella View
end note
Direttore -> View : seleziona PT sostituto
Direttore -> View : clicca "Licenzia con sostituto"

View -> Controller : gestisciLicenziamentoConSostituto()
activate Controller

Controller -> View : getIdTrainerDaLicenziare(), getIndiceSostitutoSelezionato()
View --> Controller : idDaLicenziare, indice del sostituto

Controller -> Servizio : licenziaPersonalTrainerConSostituto(idDaLicenziare, idSostituto)
activate Servizio

Servizio -> PTDAO : trovaPerId(idDaLicenziare)
activate PTDAO
PTDAO -> DB : SELECT PT da licenziare
activate DB
DB --> PTDAO : dati PT da licenziare
deactivate DB
PTDAO --> Servizio : datiTrainerDaLicenziare
deactivate PTDAO

Servizio -> Servizio : validaTrainerLicenziabile(trainerDaLicenziare)

Servizio -> PTDAO : trovaPerId(idSostituto)
activate PTDAO
PTDAO -> DB : SELECT PT sostituto
activate DB
DB --> PTDAO : dati PT sostituto
deactivate DB
PTDAO --> Servizio : datiSostituto
deactivate PTDAO

Servizio -> Servizio : isSostitutoCompatibile(trainerDaLicenziare, sostituto)
note right of Servizio
Sostituto attivo, diverso dal PT da
licenziare e con la stessa specializzazione
end note

Servizio -> SwapService : sostituisciTrainerNeiCorsi(idDaLicenziare, idSostituto)
activate SwapService

SwapService -> SwapDAO : esisteTrainerConContrattoAttivo(idSostituto)
activate SwapDAO
SwapDAO --> SwapService : true
deactivate SwapDAO

SwapService -> SwapDAO : esistonoSovrapposizioniTraCorsi(idDaLicenziare, idSostituto)
activate SwapDAO
SwapDAO -> DB : SELECT corsi dei due PT nello stesso orario
activate DB
DB --> SwapDAO : nessuna sovrapposizione
deactivate DB
SwapDAO --> SwapService : false
deactivate SwapDAO

SwapService -> SwapDAO : riassegnaCorsiEDisattivaTrainer(idDaLicenziare, idSostituto)
activate SwapDAO
note right of SwapDAO
Unica transazione: riassegna i corsi
e disattiva il PT licenziato
end note
SwapDAO -> DB : UPDATE Corso + UPDATE PT (commit)
activate DB
DB --> SwapDAO : corsi riassegnati
deactivate DB
SwapDAO --> SwapService : numero di corsi riassegnati
deactivate SwapDAO

SwapService --> Servizio : numero di corsi riassegnati
deactivate SwapService

Servizio --> Controller : licenziamento con sostituto completato
deactivate Servizio

Controller -> View : pulisciFormLicenziamento()
Controller -> Servizio : getElencoPersonalTrainer()
activate Servizio
Servizio --> Controller : List<DatiVisualizzazioneTrainer>
deactivate Servizio
Controller -> View : mostraRigheTrainer(righe)
Controller -> View : mostraSuccesso("Personal Trainer licenziato correttamente con sostituto.")
deactivate Controller

View --> Direttore : mostra conferma operazione

@enduml

' ------------------------------------------------------------
' 04 - SS4 - Calcolo retribuzioni
' ------------------------------------------------------------
@startuml DSequenzaUC5Main4
title UC5 - Main Success Scenario: Calcolo retribuzioni

autonumber

actor "Direttore" as Direttore
boundary "GestionePersonaleView\n<<Boundary>>" as View
control "GestorePersonale\n<<Controller>>" as Controller
control "servizio: ServizioContrattiPersonale\n<<Service>>" as Servizio
control "servizioRetribuzioni: ServizioRetribuzioni\n<<Service>>" as RetribuzioniService
entity "retribuzioniDAO: RetribuzioniDAO\n<<Interface>>" as RetDAO
participant "StrategiaRetribuzioneFactory\n<<Factory>>" as Factory
participant "strategia: StrategiaRetribuzione\n<<Strategy>>" as Strategia
database "scriptactive_db" as DB

Direttore -> View : clicca "Calcola retribuzioni"

View -> Controller : gestisciCalcoloRetribuzioni()
activate Controller

Controller -> Servizio : calcolaTotaleRetribuzioniMensili()
activate Servizio

Servizio -> RetribuzioniService : calcolaTotaleRetribuzioniMensili()
activate RetribuzioniService

RetribuzioniService -> RetDAO : recuperaDatiRetribuzioniMensili()
activate RetDAO
RetDAO -> DB : SELECT PT attivi e lezioni completate nel mese
activate DB
DB --> RetDAO : dati retributivi
deactivate DB
RetDAO --> RetribuzioniService : List<DatiRetribuzioneTrainer>
deactivate RetDAO

loop per ogni Personal Trainer
    RetribuzioniService -> Factory : crea(tipoRetribuzione, importoBase)
    activate Factory
    Factory --> RetribuzioniService : strategia
    deactivate Factory

    RetribuzioniService -> Strategia : calcolaStipendio(numeroLezioniCompletate)
    activate Strategia
    note right of Strategia
    Pattern Strategy: retribuzione fissa
    mensile oppure compenso a lezione
    end note
    Strategia --> RetribuzioniService : stipendio
    deactivate Strategia
end

RetribuzioniService --> Servizio : totale
deactivate RetribuzioniService

Servizio --> Controller : totale
deactivate Servizio

Controller -> View : mostraTotaleRetribuzioni(totale)
deactivate Controller

View --> Direttore : visualizza il totale delle retribuzioni mensili

@enduml

